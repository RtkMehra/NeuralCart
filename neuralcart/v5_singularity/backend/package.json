{
  "name": "@neuralcart/v5-backend",
  "version": "0.5.0",
  "private": true,
  "description": "NeuralCart Singularity backend (Docker, CI/CD, observability ready).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "migration:run": "ts-node --project tsconfig.json ./node_modules/typeorm/cli.js migration:run -d src/config/data-source.ts",
    "migration:revert": "ts-node --project tsconfig.json ./node_modules/typeorm/cli.js migration:revert -d src/config/data-source.ts",
    "seed": "ts-node --project tsconfig.json src/seed/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "@elastic/elasticsearch": "^8.12.0",
    "cors": "^2.8.5",
    "ioredis": "^5.3.2",
    "express-rate-limit": "^7.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.5",
    "pino": "^8.19.0",
    "pino-http": "^9.0.0",
    "prom-client": "^14.2.0",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.7",
    "@types/node": "^20.11.25",
    "@types/bcryptjs": "^2.4.6",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "pino-pretty": "^10.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
